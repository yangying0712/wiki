---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { TagList } from '../../components/ScopedTag';
import { idToSlug } from '../../utils/content';

// 获取所有角色
const characters = await getCollection('characters');
---

<BaseLayout title="角色档案 | 角色关系研究">
  <section class="max-w-7xl mx-auto px-6 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">👥 角色档案</h1>
      <p class="text-xl text-[var(--color-muted)]">
        深入了解每一个角色的性格特点与属性分布
      </p>
    </div>

    {characters.length === 0 ? (
      <div class="text-center py-20 editorial-card">
        <p class="text-[var(--color-muted)] text-lg">
          暂无角色数据。请在 <code class="bg-[var(--color-card)] px-2 py-1 rounded">src/content/characters/</code> 目录下添加角色文件。
        </p>
        <p class="text-sm text-[var(--color-muted)] mt-4">
          示例文件格式见项目文档。
        </p>
      </div>
    ) : (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {characters.map((character) => (
          <a 
            href={`/characters/${idToSlug(character.id)}`}
            class="editorial-card group block"
            style={`border-top: 4px solid ${character.data.color}`}
          >
            <div class="flex items-center gap-4 mb-4">
              <div 
                class="w-16 h-16 rounded-full flex items-center justify-center text-2xl font-bold text-white"
                style={`background-color: ${character.data.color}`}
              >
                {character.data.name.charAt(0)}
              </div>
              <div>
                <h2 class="text-xl font-semibold group-hover:text-[var(--color-primary)] transition-colors">
                  {character.data.name}
                </h2>
                <span class="text-sm text-[var(--color-muted)]">
                  {character.data.role === 'protagonist' && '主角'}
                  {character.data.role === 'love_interest' && '攻'}
                  {character.data.role === 'supporting' && '配角'}
                  {character.data.role === 'antagonist' && '反派'}
                </span>
              </div>
            </div>
            
            <p class="text-[var(--color-muted)] mb-4 line-clamp-2">
              {character.data.description}
            </p>
            
            {character.data.tags && (
              <TagList tags={character.data.tags.slice(0, 3)} size="sm" client:load />
            )}
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
