---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RadarCompare } from '../components/AttributeRadar';
import { StockTickerList } from '../components/StockTickerItem';
import { TagList } from '../components/ScopedTag';

// 崔要员×金率音 CP数据 - 蓝红配色
const sampleCharacters = [
  {
    name: '崔要员',
    color: '#2563eb', // 蓝色 - 公位
    attributes: { intelligence: 85, strength: 88, charm: 92, loyalty: 95, cunning: 80, emotional: 70 },
  },
  {
    name: '金率音',
    color: '#dc2626', // 红色 - 受位
    attributes: { intelligence: 90, strength: 65, charm: 75, loyalty: 88, cunning: 85, emotional: 80 },
  },
];

const sampleStockData = [
  {
    name: '崔要员',
    color: '#2563eb', // 蓝色
    currentValue: 88,
    previousValue: 80,
    history: [{ value: 60 }, { value: 65 }, { value: 70 }, { value: 75 }, { value: 80 }, { value: 85 }, { value: 88 }],
  },
  {
    name: '金率音',
    color: '#dc2626', // 红色
    currentValue: 90,
    previousValue: 80,
    history: [{ value: 40 }, { value: 55 }, { value: 65 }, { value: 70 }, { value: 80 }, { value: 85 }, { value: 90 }],
  },
];

const sampleTags = [
  'trope:前辈后辈',
  'trope:卧底恋情',
  'vibe:甜蜜',
  'status:热恋中',
  'character:崔要员',
  'character:金率音',
];
---

<BaseLayout title="首页 | 角色关系研究">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 py-20">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-5xl lg:text-6xl font-bold leading-tight mb-6">
            <span class="text-gradient bg-gradient-to-r from-blue-600 via-purple-500 to-red-600">
              角色关系研究
            </span>
            <br />
            <span class="text-[var(--color-text)]">与剧情伏笔追踪</span>
          </h1>
          <p class="text-xl text-[var(--color-muted)] mb-8 leading-relaxed">
            一个结构化的数字花园，用于深度分析角色关系、追踪剧情伏笔、
            记录情感走势。采用数据驱动的方式，让每一个细节都有迹可循。
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="/characters"
              class="px-6 py-3 bg-indigo-500 text-white rounded-lg font-medium hover:bg-indigo-600 transition-colors"
            >
              探索角色
            </a>
            <a
              href="/relationships"
              class="px-6 py-3 border border-[var(--color-border)] rounded-lg font-medium hover:bg-[var(--color-card)] transition-colors"
            >
              查看关系图
            </a>
          </div>
        </div>
        
        <!-- 标签展示 -->
        <div class="editorial-card">
          <h3 class="text-lg font-semibold mb-4">分面标签系统</h3>
          <TagList tags={sampleTags} client:load />
          <p class="text-sm text-[var(--color-muted)] mt-4">
            类似 AO3 的分面标签，支持按套路、氛围、状态等维度筛选内容。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 股市行情区 -->
  <section class="py-16 bg-[var(--color-card)]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-3xl font-bold">📈 CP 股市</h2>
          <p class="text-[var(--color-muted)] mt-2">实时追踪各角色的好感度走势</p>
        </div>
        <a href="/relationships" class="text-indigo-500 hover:underline">
          查看完整行情 →
        </a>
      </div>
      <StockTickerList items={sampleStockData} client:load />
    </div>
  </section>

  <!-- 雷达图对比区 -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold">⬡ 六边形战士对比</h2>
        <p class="text-[var(--color-muted)] mt-2">
          多维度属性对比，一眼看清各角色的优势与短板
        </p>
      </div>
      <div class="editorial-card max-w-4xl mx-auto">
        <RadarCompare characters={sampleCharacters} client:load />
      </div>
    </div>
  </section>

  <!-- 功能模块网格 -->
  <section class="py-16 bg-[var(--color-card)]">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-12">核心功能</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/characters" class="editorial-card group">
          <div class="text-4xl mb-4">👥</div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            角色档案
          </h3>
          <p class="text-[var(--color-muted)]">
            详细的角色资料库，包含属性雷达图、情感历程、关联关系等。
          </p>
        </a>
        
        <a href="/relationships" class="editorial-card group">
          <div class="text-4xl mb-4">💕</div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            关系图谱
          </h3>
          <p class="text-[var(--color-muted)]">
            可视化关系网络，连线粗细表情感浓度，颜色表关系性质。
          </p>
        </a>
        
        <a href="/clues" class="editorial-card group">
          <div class="text-4xl mb-4">🔍</div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            伏笔追踪
          </h3>
          <p class="text-[var(--color-muted)]">
            侦探墙模式，追踪每一个伏笔的埋设与回收状态。
          </p>
        </a>
        
        <a href="/extras" class="editorial-card group">
          <div class="text-4xl mb-4">📝</div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            随笔分析
          </h3>
          <p class="text-[var(--color-muted)]">
            独立的短篇与分析文章，支持动态主题色与剧透警告。
          </p>
        </a>
        
        <a href="/quotes" class="editorial-card group">
          <div class="text-4xl mb-4">💬</div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            金句记录
          </h3>
          <p class="text-[var(--color-muted)]">
            收录角色经典台词与名场面对白，高亮名言。
          </p>
        </a>
        
        <a href="/chapters" class="editorial-card group">
          <div class="text-4xl mb-4">📖</div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            章节时间轴
          </h3>
          <p class="text-[var(--color-muted)]">
            以章节为锚点，串联所有相关内容与事件。
          </p>
        </a>
        
        <div class="editorial-card bg-gradient-to-br from-indigo-500/10 to-purple-500/10">
          <div class="text-4xl mb-4">✨</div>
          <h3 class="text-xl font-semibold mb-2">
            更多功能
          </h3>
          <p class="text-[var(--color-muted)]">
            情感波动图、对话气泡、金句卡片、剧透折叠...持续更新中。
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
