---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ImageCarousel } from '../components/ImageCarousel';
import { StockTickerList } from '../components/StockTickerItem';
import { TagList } from '../components/ScopedTag';

// 轮播图数据 - 占位图
const carouselImages = [
  {
    src: '/images/carousel-1.jpg',
    alt: '关系羁绊',
    title: '探索角色羁绊',
    description: '深入了解每一段关系背后的故事与情感',
  },
  {
    src: '/images/carousel-2.jpg',
    alt: '精彩剧情',
    title: '追踪剧情发展',
    description: '记录每一个令人心动的名场面',
  },
  {
    src: '/images/carousel-3.jpg',
    alt: '角色档案',
    title: '完整角色档案',
    description: '性格、属性、情感历程，一应俱全',
  },
];

const sampleStockData = [
  {
    name: '崔要员',
    color: '#2563eb', // 蓝色
    currentValue: 88,
    previousValue: 80,
    history: [{ value: 60 }, { value: 65 }, { value: 70 }, { value: 75 }, { value: 80 }, { value: 85 }, { value: 88 }],
  },
  {
    name: '金率音',
    color: '#dc2626', // 红色
    currentValue: 90,
    previousValue: 80,
    history: [{ value: 40 }, { value: 55 }, { value: 65 }, { value: 70 }, { value: 80 }, { value: 85 }, { value: 90 }],
  },
];

const sampleTags = [
  'trope:前辈后辈',
  'trope:卧底恋情',
  'vibe:甜蜜',
  'status:热恋中',
  'character:崔要员',
  'character:金率音',
];
---

<BaseLayout title="首页 | Kind-Black-Cat">
  <!-- Hero Section with Carousel -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 py-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="animate-fade-in-left">
          <h1 class="text-5xl lg:text-6xl font-bold leading-tight mb-6">
            <span class="text-gradient bg-gradient-to-r from-blue-600 via-purple-500 to-red-600 animate-gradient">
              Kind-Black-Cat
            </span>
            <br />
            <span class="text-[var(--color-text)]">鹿右向个人网站</span>
          </h1>
          <p class="text-xl text-[var(--color-muted)] mb-8 leading-relaxed">
            记录个人角色关系、剧情伏笔、情感走势理解，堆放随笔和本子翻译。
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="/characters"
              class="group px-6 py-3 bg-gradient-to-r from-indigo-500 to-purple-500 text-white rounded-lg font-medium hover:from-indigo-600 hover:to-purple-600 transition-all duration-300 hover:scale-105 hover:shadow-lg"
            >
              <span class="flex items-center gap-2">
                探索角色
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </span>
            </a>
            <a
              href="/relationships"
              class="group px-6 py-3 border border-[var(--color-border)] rounded-lg font-medium hover:bg-[var(--color-card)] transition-all duration-300 hover:scale-105"
            >
              <span class="flex items-center gap-2">
                查看关系图
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </span>
            </a>
          </div>
        </div>
        
        <!-- 标签展示 -->
        <div class="editorial-card animate-fade-in-right hover:shadow-xl transition-shadow duration-300">
          <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
            <span class="text-2xl">🏷️</span> 分面标签系统
          </h3>
          <TagList tags={sampleTags} client:load />
          <p class="text-sm text-[var(--color-muted)] mt-4">
            类似 AO3 的分面标签，支持按套路、氛围、状态等维度筛选内容。（待实现）
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 图片轮播区 -->
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold flex items-center justify-center gap-3">
          <span class="text-4xl animate-bounce-slow">✨</span>
          精彩瞬间
          <span class="text-4xl animate-bounce-slow animation-delay-500">✨</span>
        </h2>
        <p class="text-[var(--color-muted)] mt-2">回顾那些令人心动的名场面</p>
      </div>
      <ImageCarousel images={carouselImages} client:load />
    </div>
  </section>

  <!-- 股市行情区 -->
  <section class="py-16 bg-[var(--color-card)]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-3xl font-bold flex items-center gap-2">
            <span class="animate-pulse">📈</span> CP 股市（仅供娱乐）
          </h2>
          <p class="text-[var(--color-muted)] mt-2">回合制端水，现在是谁的回合？</p>
        </div>
        <a href="/relationships" class="text-indigo-500 hover:underline flex items-center gap-1 group">
          查看完整行情 
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      </div>
      <StockTickerList items={sampleStockData} client:load />
    </div>
  </section>

  <!-- 功能模块网格 -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-12 flex items-center justify-center gap-3">
        <span class="text-4xl">🚀</span> 核心功能
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/characters" class="editorial-card group block hover:scale-[1.02] transition-all duration-300">
          <div class="mb-4 flex items-center justify-start">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-indigo-500/20 to-purple-500/20 flex items-center justify-center text-4xl transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3">
              👤
            </div>
          </div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            角色档案
          </h3>
          <p class="text-[var(--color-muted)]">
            详细的角色资料库，包含属性雷达图、情感历程、关联关系等。
          </p>
        </a>
        
        <a href="/relationships" class="editorial-card group block hover:scale-[1.02] transition-all duration-300">
          <div class="mb-4 flex items-center justify-start">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-pink-500/20 to-red-500/20 flex items-center justify-center text-4xl transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3">
              💕
            </div>
          </div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            关系图谱
          </h3>
          <p class="text-[var(--color-muted)]">
            可视化关系网络，探索角色之间的羁绊与情感故事。
          </p>
        </a>
        
        <a href="/clues" class="editorial-card group block hover:scale-[1.02] transition-all duration-300">
          <div class="mb-4 flex items-center justify-start">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-500/20 to-orange-500/20 flex items-center justify-center text-4xl transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3">
              🔍
            </div>
          </div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            伏笔追踪
          </h3>
          <p class="text-[var(--color-muted)]">
            侦探墙模式，追踪每一个伏笔的埋设与回收状态。
          </p>
        </a>
        
        <a href="/extras" class="editorial-card group block hover:scale-[1.02] transition-all duration-300">
          <div class="mb-4 flex items-center justify-start">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-green-500/20 to-emerald-500/20 flex items-center justify-center text-4xl transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3">
              📝
            </div>
          </div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            随笔分析
          </h3>
          <p class="text-[var(--color-muted)]">
            剧情/CP分析、韩网翻译、脑洞段子、鹿压抑专区等分类内容。
          </p>
        </a>
        
        <a href="/gallery" class="editorial-card group block hover:scale-[1.02] transition-all duration-300">
          <div class="mb-4 flex items-center justify-start">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-pink-500/20 to-rose-500/20 flex items-center justify-center text-4xl transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3">
              🖼️
            </div>
          </div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            图片集
          </h3>
          <p class="text-[var(--color-muted)]">
            本子翻译与模型截图收藏，分类浏览精彩图片。
          </p>
        </a>
        
        <a href="/quotes" class="editorial-card group block hover:scale-[1.02] transition-all duration-300">
          <div class="mb-4 flex items-center justify-start">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500/20 to-cyan-500/20 flex items-center justify-center text-4xl transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3">
              💬
            </div>
          </div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            金句记录
          </h3>
          <p class="text-[var(--color-muted)]">
            收录角色经典台词与名场面对白，高亮名言。
          </p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  
  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateX(30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  
  @keyframes gradient {
    0%, 100% {
      background-size: 200% 200%;
      background-position: left center;
    }
    50% {
      background-size: 200% 200%;
      background-position: right center;
    }
  }
  
  @keyframes bounceSlow {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }
  
  .animate-fade-in-left {
    animation: fadeInLeft 0.8s ease-out both;
  }
  
  .animate-fade-in-right {
    animation: fadeInRight 0.8s ease-out 0.2s both;
  }
  
  .animate-gradient {
    animation: gradient 3s ease infinite;
  }
  
  .animate-bounce-slow {
    animation: bounceSlow 2s ease-in-out infinite;
  }
  
  .animation-delay-500 {
    animation-delay: 0.5s;
  }
</style>
