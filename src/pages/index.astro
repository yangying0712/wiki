---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RadarCompare } from '../components/AttributeRadar';
import { StockTickerList } from '../components/StockTickerItem';
import { TagList } from '../components/ScopedTag';

// 崔要员×金率音 CP数据 - 蓝红配色
const sampleCharacters = [
  {
    name: '崔要员',
    color: '#2563eb', // 蓝色 - 公位
    attributes: { intelligence: 85, strength: 88, charm: 92, loyalty: 95, cunning: 80, emotional: 70 },
  },
  {
    name: '金率音',
    color: '#dc2626', // 红色 - 受位
    attributes: { intelligence: 90, strength: 65, charm: 75, loyalty: 88, cunning: 85, emotional: 80 },
  },
];

const sampleStockData = [
  {
    name: '崔要员',
    color: '#2563eb', // 蓝色
    currentValue: 88,
    previousValue: 80,
    history: [{ value: 60 }, { value: 65 }, { value: 70 }, { value: 75 }, { value: 80 }, { value: 85 }, { value: 88 }],
  },
  {
    name: '金率音',
    color: '#dc2626', // 红色
    currentValue: 90,
    previousValue: 80,
    history: [{ value: 40 }, { value: 55 }, { value: 65 }, { value: 70 }, { value: 80 }, { value: 85 }, { value: 90 }],
  },
];

const sampleTags = [
  'trope:前辈后辈',
  'trope:卧底恋情',
  'vibe:甜蜜',
  'status:热恋中',
  'character:崔要员',
  'character:金率音',
];
---

<BaseLayout title="首页 | Kind-Black-Cat">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 py-20">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-5xl lg:text-6xl font-bold leading-tight mb-6">
            <span class="text-gradient bg-gradient-to-r from-blue-600 via-purple-500 to-red-600">
              Kind-Black-Cat
            </span>
            <br />
            <span class="text-[var(--color-text)]">鹿右向个人网站</span>
          </h1>
          <p class="text-xl text-[var(--color-muted)] mb-8 leading-relaxed">
            记录个人角色关系、剧情伏笔、情感走势理解，堆放随笔和本子翻译。
          <div class="flex flex-wrap gap-4">
            <a
              href="/characters"
              class="px-6 py-3 bg-indigo-500 text-white rounded-lg font-medium hover:bg-indigo-600 transition-colors"
            >
              探索角色
            </a>
            <a
              href="/relationships"
              class="px-6 py-3 border border-[var(--color-border)] rounded-lg font-medium hover:bg-[var(--color-card)] transition-colors"
            >
              查看关系图
            </a>
          </div>
        </div>
        
        <!-- 标签展示 -->
        <div class="editorial-card">
          <h3 class="text-lg font-semibold mb-4">分面标签系统</h3>
          <TagList tags={sampleTags} client:load />
          <p class="text-sm text-[var(--color-muted)] mt-4">
            类似 AO3 的分面标签，支持按套路、氛围、状态等维度筛选内容。（待实现）
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 股市行情区 -->
  <section class="py-16 bg-[var(--color-card)]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-3xl font-bold">📈 CP 股市（仅供娱乐）</h2>
          <p class="text-[var(--color-muted)] mt-2">回合制端水，现在是谁的回合？</p>
        </div>
        <a href="/relationships" class="text-indigo-500 hover:underline">
          查看完整行情 →
        </a>
      </div>
      <StockTickerList items={sampleStockData} client:load />
    </div>
  </section>

  <!-- 雷达图对比区 -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold">⬡ 六边形战士对比</h2>
        <p class="text-[var(--color-muted)] mt-2">
          多维度对比，你也要论战力？
        </p>
      </div>
      <div class="editorial-card max-w-4xl mx-auto">
        <RadarCompare characters={sampleCharacters} client:load />
      </div>
    </div>
  </section>

  <!-- 功能模块网格 -->
  <section class="py-16 bg-[var(--color-card)]">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-12">核心功能</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
<a href="/characters" class="editorial-card group">
  <div class="mb-4 flex items-center justify-start">
    <svg class="w-16 h-16 transition-transform duration-300 group-hover:scale-110" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="glass-gradient-icon" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.35"/>
          <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.05"/>
        </linearGradient>
        <filter id="soft-shadow-icon" x="-50%" y="-50%" width="200%" height="200%">
          <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.15"/>
        </filter>
        <linearGradient id="border-gradient-icon" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.8"/>
          <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.2"/>
        </linearGradient>
      </defs>

      <g transform="rotate(-6 32 32)">
        <rect x="14" y="10" width="36" height="48" rx="6" 
              fill="url(#glass-gradient-icon)" 
              stroke="url(#border-gradient-icon)" 
              stroke-width="1"/>
      </g>

      <rect x="14" y="10" width="36" height="48" rx="6" 
            fill="url(#glass-gradient-icon)" 
            stroke="url(#border-gradient-icon)" 
            stroke-width="1.5" 
            filter="url(#soft-shadow-icon)"/>

      <g opacity="0.9">
        <circle cx="32" cy="28" r="7" fill="#FFFFFF"/>
        <path d="M19 50V46C19 41.5817 22.5817 38 27 38H37C41.4183 38 45 41.5817 45 46V50" 
              stroke="#FFFFFF" 
              stroke-width="2.5" 
              stroke-linecap="round"/>
      </g>
      
      <circle cx="44" cy="16" r="1.5" fill="#FFFFFF" fill-opacity="0.6"/>
    </svg>
  </div>

  <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
    角色档案
  </h3>
  <p class="text-[var(--color-muted)]">
    详细的角色资料库，包含属性雷达图、情感历程、关联关系等。
  </p>
</a>
        
<a href="/relationships" class="editorial-card group">
  <div class="mb-4 flex items-center justify-start">
    <svg class="w-16 h-16 transition-transform duration-300 group-hover:scale-110" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="pink-glass-fill" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#FFE4E6" stop-opacity="0.7"/> <stop offset="100%" stop-color="#FFF0F5" stop-opacity="0.3"/> </linearGradient>
        
        <linearGradient id="strong-highlight-border" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#FFFFFF" stop-opacity="1"/>
          <stop offset="100%" stop-color="#FFDEE9" stop-opacity="0.5"/>
        </linearGradient>
        
        <filter id="defined-shadow-pink" x="-50%" y="-50%" width="200%" height="200%">
          <feDropShadow dx="0" dy="5" stdDeviation="6" flood-color="#4A0E2E" flood-opacity="0.25"/>
        </filter>

        <linearGradient id="inner-petal-accent" x1="0" y1="0" x2="1" y2="1">
           <stop offset="0%" stop-color="#F472B6" stop-opacity="0.2"/>
           <stop offset="100%" stop-color="#F472B6" stop-opacity="0.05"/>
        </linearGradient>
      </defs>

      <g filter="url(#defined-shadow-pink)">
        <path d="M32 12 C 42 12, 50 20, 50 30 C 50 42, 40 52, 32 52 C 24 52, 14 42, 14 30 C 14 20, 22 12, 32 12 Z" 
              fill="url(#pink-glass-fill)" 
              stroke="url(#strong-highlight-border)" 
              stroke-width="1.5"/>
        
        <g opacity="0.95">
            <path d="M32 50 C 22 50, 16 40, 18 30 C 20 20, 30 16, 38 22" 
                  fill="url(#pink-glass-fill)" 
                  stroke="url(#strong-highlight-border)" 
                  stroke-width="1.5" stroke-linecap="round"/>
            <path d="M32 14 C 42 14, 48 24, 46 34 C 44 44, 34 48, 26 42" 
                  fill="url(#pink-glass-fill)" 
                  stroke="url(#strong-highlight-border)" 
                  stroke-width="1.5" stroke-linecap="round"/>
        </g>

        <g>
            <circle cx="32" cy="32" r="10" fill="url(#pink-glass-fill)" stroke="url(#strong-highlight-border)" stroke-width="1.5"/>
            <circle cx="32" cy="32" r="7" fill="url(#inner-petal-accent)"/>
            <path d="M32 28 C 34 28, 36 30, 36 32 C 36 35, 33 36, 31 35 C 29 34, 29 30, 32 29" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" opacity="0.8"/>
        </g>
      </g>
      
      <circle cx="24" cy="20" r="2" fill="#FFFFFF" fill-opacity="0.9" filter="url(#defined-shadow-pink)"/>
      <circle cx="44" cy="46" r="1.5" fill="#FFFFFF" fill-opacity="0.7"/>
    </svg>
  </div>

  <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
    关系图谱
  </h3>
  <p class="text-[var(--color-muted)]">
    可视化关系网络，连线粗细表情感浓度，颜色表关系性质。
  </p>
</a>
        
        <a href="/clues" class="editorial-card group">
          <div class="text-4xl mb-4">🔍</div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            伏笔追踪
          </h3>
          <p class="text-[var(--color-muted)]">
            侦探墙模式，追踪每一个伏笔的埋设与回收状态。
          </p>
        </a>
        
        <a href="/extras" class="editorial-card group">
          <div class="text-4xl mb-4">📝</div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            随笔分析
          </h3>
          <p class="text-[var(--color-muted)]">
            独立的短篇与分析文章，支持动态主题色与剧透警告。
          </p>
        </a>
        
        <a href="/quotes" class="editorial-card group">
          <div class="text-4xl mb-4">💬</div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            金句记录
          </h3>
          <p class="text-[var(--color-muted)]">
            收录角色经典台词与名场面对白，高亮名言。
          </p>
        </a>
        
        <a href="/chapters" class="editorial-card group">
          <div class="text-4xl mb-4">📖</div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-indigo-500 transition-colors">
            章节时间轴（未实现）
          </h3>
          <p class="text-[var(--color-muted)]">
            以章节为锚点，串联所有相关内容与事件。
          </p>
        </a>
        
        <div class="editorial-card bg-gradient-to-br from-indigo-500/10 to-purple-500/10">
          <div class="text-4xl mb-4">✨</div>
          <h3 class="text-xl font-semibold mb-2">
            更多功能
          </h3>
          <p class="text-[var(--color-muted)]">
            股价波动图、对话气泡、金句卡片、剧透折叠...持续更新中。
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
