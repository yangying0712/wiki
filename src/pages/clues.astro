---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ClueTracker } from '../components/ClueTracker';
import { ClueManager } from '../components/ClueManager';
import { idToSlug } from '../utils/content';

// 获取所有伏笔和章节
const cluesCollection = await getCollection('clues');
const chaptersCollection = await getCollection('chapters');

// 创建章节 Map 用于快速查找 (使用 id 作为 key)
const chaptersMap = new Map(
  chaptersCollection.map((chapter) => [chapter.id, chapter.data.number])
);

// 转换为 ClueTracker 需要的格式，正确解析章节引用
// Astro 5.x 中 reference 返回的是包含 id 的对象
const clues = cluesCollection.map((clue) => ({
  id: idToSlug(clue.id),
  title: clue.data.title,
  description: clue.data.description,
  status: clue.data.status,
  plantedChapter: chaptersMap.get(clue.data.plantedIn.id) ?? 1,
  recoveredChapter: clue.data.recoveredIn 
    ? chaptersMap.get(clue.data.recoveredIn.id) 
    : undefined,
  importance: clue.data.importance,
  theories: clue.data.theories,
}));

// 转换为管理组件需要的格式
const cluesForManager = clues.map((clue) => ({
  title: clue.title,
  description: clue.description,
  status: clue.status,
  plantedChapter: clue.plantedChapter,
  recoveredChapter: clue.recoveredChapter,
  importance: clue.importance,
  theories: clue.theories || [],
}));
---

<BaseLayout title="伏笔墙 | 角色关系研究">
  <section class="max-w-5xl mx-auto px-6 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">🔍 伏笔追踪墙</h1>
      <p class="text-xl text-[var(--color-muted)]">
        追踪每一个伏笔的埋设与回收状态，支持增删改查
      </p>
    </div>

    <!-- 伏笔管理区 -->
    <div class="mb-12">
      <ClueManager initialClues={cluesForManager} client:load />
    </div>

    <!-- 分隔线 -->
    <div class="border-t border-[var(--color-border)] my-8"></div>

    <!-- 伏笔追踪展示区 -->
    <div>
      <h2 class="text-2xl font-bold mb-6">📋 伏笔追踪器</h2>
      {clues.length === 0 ? (
        <div class="text-center py-12 editorial-card">
          <p class="text-[var(--color-muted)] text-lg">
            暂无伏笔数据。使用上方管理工具添加伏笔，或在 <code class="bg-[var(--color-card)] px-2 py-1 rounded">src/content/clues/</code> 目录下添加伏笔文件。
          </p>
        </div>
      ) : (
        <ClueTracker clues={clues} client:load />
      )}
    </div>
  </section>
</BaseLayout>
