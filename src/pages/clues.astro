---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ClueTracker } from '../components/ClueTracker';

// 获取所有伏笔和章节
const cluesCollection = await getCollection('clues');
const chaptersCollection = await getCollection('chapters');

// 创建章节 Map 用于快速查找
const chaptersMap = new Map(
  chaptersCollection.map((chapter) => [chapter.slug, chapter.data.number])
);

// 转换为 ClueTracker 需要的格式，正确解析章节引用
const clues = cluesCollection.map((clue) => ({
  id: clue.slug,
  title: clue.data.title,
  description: clue.data.description,
  status: clue.data.status,
  plantedChapter: chaptersMap.get(clue.data.plantedIn.slug) ?? 1,
  recoveredChapter: clue.data.recoveredIn 
    ? chaptersMap.get(clue.data.recoveredIn.slug) 
    : undefined,
  importance: clue.data.importance,
  theories: clue.data.theories,
}));
---

<BaseLayout title="伏笔墙 | 角色关系研究">
  <section class="max-w-5xl mx-auto px-6 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">🔍 伏笔追踪墙</h1>
      <p class="text-xl text-[var(--color-muted)]">
        追踪每一个伏笔的埋设与回收状态
      </p>
    </div>

    {clues.length === 0 ? (
      <div class="text-center py-20 editorial-card">
        <p class="text-[var(--color-muted)] text-lg">
          暂无伏笔数据。请在 <code class="bg-[var(--color-card)] px-2 py-1 rounded">src/content/clues/</code> 目录下添加伏笔文件。
        </p>
        <div class="mt-8 p-6 bg-[var(--color-card)] rounded-lg text-left max-w-2xl mx-auto">
          <h3 class="font-semibold mb-2">示例伏笔数据结构：</h3>
          <pre class="text-sm overflow-x-auto"><code>{`---
title: "神秘信件"
description: "第3章出现的未署名信件"
status: "planted"
plantedIn: chapter-3
importance: "major"
theories:
  - "可能来自失踪的母亲"
  - "可能是反派的陷阱"
---`}</code></pre>
        </div>
      </div>
    ) : (
      <ClueTracker clues={clues} client:load />
    )}
  </section>
</BaseLayout>
