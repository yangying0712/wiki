---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { idToSlug } from '../../utils/content';

// 获取所有关系
const relationships = await getCollection('relationships');
const characters = await getCollection('characters');

// 为每个关系获取角色信息
const relationshipsWithMembers = relationships.map((rel) => {
  const memberDetails = rel.data.members.map((memberRef: { id: string }) => {
    const char = characters.find(c => c.id === memberRef.id);
    return char ? { name: char.data.name, color: char.data.color, avatar: char.data.avatar } : null;
  }).filter((m): m is { name: string; color: string; avatar: string | undefined } => m !== null);
  return { ...rel, memberDetails };
});
---

<BaseLayout title="关系图谱 | Kind-Black-Cat">
  <section class="max-w-7xl mx-auto px-6 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">💕 关系图谱</h1>
      <p class="text-xl text-[var(--color-muted)]">
        探索角色之间的羁绊与故事
      </p>
    </div>

    {relationships.length === 0 ? (
      <div class="text-center py-20 editorial-card">
        <p class="text-[var(--color-muted)] text-lg">
          暂无关系数据。请在 <code class="bg-[var(--color-card)] px-2 py-1 rounded">src/content/relationships/</code> 目录下添加关系文件。
        </p>
      </div>
    ) : (
      <>
        <!-- 关系卡片网格 -->
        <div class="grid md:grid-cols-2 gap-8 mb-12">
          {relationshipsWithMembers.map((rel, index) => {
            const primaryColor = rel.data.colors?.primary || rel.memberDetails[0]?.color || '#6366f1';
            const secondaryColor = rel.data.colors?.secondary || rel.memberDetails[1]?.color || '#f43f5e';
            return (
              <a 
                href={`/relationships/${idToSlug(rel.id)}`}
                class="group relative rounded-2xl overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl"
                style={`animation: fadeInUp 0.5s ease-out ${index * 100}ms both;`}
              >
                <!-- 渐变背景 -->
                <div 
                  class="absolute inset-0 opacity-20 group-hover:opacity-30 transition-opacity duration-300"
                  style={`background: linear-gradient(135deg, ${primaryColor}, ${secondaryColor});`}
                ></div>
                
                <!-- 装饰性光晕 -->
                <div 
                  class="absolute -top-20 -right-20 w-40 h-40 rounded-full blur-3xl opacity-30 group-hover:opacity-50 transition-opacity duration-500"
                  style={`background: ${primaryColor};`}
                ></div>
                <div 
                  class="absolute -bottom-20 -left-20 w-40 h-40 rounded-full blur-3xl opacity-30 group-hover:opacity-50 transition-opacity duration-500"
                  style={`background: ${secondaryColor};`}
                ></div>
                
                <div class="relative p-6 bg-[var(--color-card)]/80 backdrop-blur-sm border border-[var(--color-border)]">
                  <!-- 角色头像 -->
                  <div class="flex items-center justify-center gap-4 mb-6">
                    {rel.memberDetails.map((member: { name: string; color: string; avatar?: string }, i: number) => (
                      <div class="relative">
                        <div 
                          class="w-16 h-16 rounded-full border-3 flex items-center justify-center text-2xl font-bold text-white shadow-lg transition-transform duration-300 group-hover:scale-110 overflow-hidden"
                          style={`border-color: ${member.color}; background-color: ${member.color}; box-shadow: 0 0 20px ${member.color}40;`}
                        >
                          {member.avatar ? (
                            <img src={member.avatar} alt={member.name} class="w-full h-full object-cover" />
                          ) : (
                            member.name.charAt(0)
                          )}
                        </div>
                        {i === 0 && rel.memberDetails.length > 1 && (
                          <div class="absolute -right-3 top-1/2 -translate-y-1/2 text-2xl animate-pulse">💕</div>
                        )}
                      </div>
                    ))}
                  </div>
                  
                  <!-- 关系名称 -->
                  <h3 
                    class="text-2xl font-bold text-center mb-4 bg-clip-text text-transparent"
                    style={`background-image: linear-gradient(135deg, ${primaryColor}, ${secondaryColor});`}
                  >
                    {rel.data.name}
                  </h3>
                  
                  <!-- 关系类型标签 -->
                  <div class="flex justify-center gap-2 flex-wrap mb-4">
                    <span 
                      class="px-3 py-1 rounded-full text-xs font-medium"
                      style={`background: ${primaryColor}20; color: ${primaryColor};`}
                    >
                      {rel.data.type === 'romantic' && '💕 恋人'}
                      {rel.data.type === 'rivals' && '⚔️ 宿敌'}
                      {rel.data.type === 'frenemies' && '🎭 亦敌亦友'}
                      {rel.data.type === 'siblings' && '👨‍👩‍👧‍👦 手足'}
                      {rel.data.type === 'mentor' && '📚 师徒'}
                      {rel.data.type === 'complicated' && '❓ 复杂'}
                    </span>
                    <span 
                      class="px-3 py-1 rounded-full text-xs font-medium"
                      style={`background: ${secondaryColor}20; color: ${secondaryColor};`}
                    >
                      {rel.data.nature === 'pure' && '💖 纯爱'}
                      {rel.data.nature === 'twisted' && '💜 扭曲'}
                      {rel.data.nature === 'utilize' && '🔗 利用'}
                      {rel.data.nature === 'mutual' && '🤝 相互'}
                    </span>
                  </div>
                  
                  <!-- 简短状态指示（用图形化方式而非数值） -->
                  <div class="flex justify-center gap-6 text-sm">
                    <div class="flex items-center gap-2">
                      <span class="text-pink-500">💗</span>
                      <div class="w-20 h-2 bg-[var(--color-border)] rounded-full overflow-hidden">
                        <div 
                          class="h-full bg-gradient-to-r from-pink-400 to-pink-600 rounded-full transition-all duration-500"
                          style={`width: ${rel.data.vibeScore}%;`}
                        ></div>
                      </div>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="text-purple-500">💔</span>
                      <div class="w-20 h-2 bg-[var(--color-border)] rounded-full overflow-hidden">
                        <div 
                          class="h-full bg-gradient-to-r from-purple-400 to-purple-600 rounded-full transition-all duration-500"
                          style={`width: ${rel.data.angstScore}%;`}
                        ></div>
                      </div>
                    </div>
                  </div>
                  
                  <!-- 查看详情提示 -->
                  <div class="mt-6 text-center">
                    <span class="text-sm text-[var(--color-muted)] group-hover:text-[var(--color-primary)] transition-colors">
                      点击查看详情 →
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </>
    )}
  </section>
</BaseLayout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
