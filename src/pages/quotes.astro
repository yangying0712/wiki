---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { QuoteCard } from '../components/QuoteCard';
import { QuoteManager } from '../components/QuoteManager';
import { TagList } from '../components/ScopedTag';

// 获取所有金句和角色
const quotesCollection = await getCollection('quotes');
const charactersCollection = await getCollection('characters');

// 创建角色 Map 用于快速查找
const charactersMap = new Map(
  charactersCollection.map((char) => [char.id, { name: char.data.name, color: char.data.color }])
);

// 按重要性排序，iconic > memorable > normal
const importanceOrder: Record<string, number> = { iconic: 0, memorable: 1, normal: 2 };
const sortedQuotes = quotesCollection.sort((a, b) => 
  (importanceOrder[a.data.importance] ?? 2) - (importanceOrder[b.data.importance] ?? 2)
);

// 转换为管理组件需要的格式
const quotesForManager = sortedQuotes.map((quoteItem) => {
  const speaker = charactersMap.get(quoteItem.data.speaker.id);
  return {
    quote: quoteItem.data.quote,
    speaker: quoteItem.data.speaker.id,
    speakerColor: speaker?.color,
    chapter: quoteItem.data.chapter,
    context: quoteItem.data.context,
    importance: quoteItem.data.importance,
    tags: quoteItem.data.tags || [],
  };
});

// 转换角色列表供管理组件使用
const speakersForManager = charactersCollection.map((char) => ({
  id: char.id,
  name: char.data.name,
  color: char.data.color,
}));
---

<BaseLayout title="金句记录 | Kind-Black-Cat">
  <section class="max-w-5xl mx-auto px-6 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4 flex items-center justify-center gap-3">
        <span class="text-5xl animate-bounce-slow">💬</span> 金句记录
      </h1>
      <p class="text-xl text-[var(--color-muted)]">
        收录角色经典台词与名场面对白
      </p>
    </div>

    <!-- 金句管理区 -->
    <div class="mb-12 editorial-card">
      <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
        <span class="text-xl">⚙️</span> 金句管理
      </h3>
      <QuoteManager 
        initialQuotes={quotesForManager} 
        speakers={speakersForManager}
        client:load 
      />
    </div>

    <!-- 分隔装饰 -->
    <div class="relative my-12">
      <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-[var(--color-border)]"></div>
      </div>
      <div class="relative flex justify-center">
        <span class="px-4 bg-[var(--color-background)] text-[var(--color-muted)] text-sm">
          ✨ 精选金句 ✨
        </span>
      </div>
    </div>

    <!-- 金句展示区 -->
    <div>
      <h2 class="text-2xl font-bold mb-8 flex items-center gap-2">
        <span class="text-3xl">📜</span> 金句展示
      </h2>
      {sortedQuotes.length === 0 ? (
        <div class="text-center py-12 editorial-card">
          <div class="text-6xl mb-4 opacity-50">💭</div>
          <p class="text-[var(--color-muted)] text-lg">
            暂无金句数据。使用上方管理工具添加，或在 <code class="bg-[var(--color-card)] px-2 py-1 rounded">src/content/quotes/</code> 目录下添加金句文件。
          </p>
        </div>
      ) : (
        <div class="space-y-8">
          {sortedQuotes.map((quoteItem, index) => {
            const speaker = charactersMap.get(quoteItem.data.speaker.id);
            return (
              <div 
                class="animate-fade-in"
                style={`animation-delay: ${index * 100}ms;`}
              >
                <QuoteCard 
                  quote={quoteItem.data.quote}
                  speaker={speaker?.name}
                  speakerColor={speaker?.color}
                  chapter={quoteItem.data.chapter}
                  context={quoteItem.data.context}
                  importance={quoteItem.data.importance}
                  client:load
                />
                {quoteItem.data.tags && quoteItem.data.tags.length > 0 && (
                  <div class="mt-3 ml-6">
                    <TagList tags={quoteItem.data.tags} size="sm" client:load />
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes bounceSlow {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }
  
  .animate-fade-in {
    animation: fadeIn 0.5s ease-out both;
  }
  
  .animate-bounce-slow {
    animation: bounceSlow 2s ease-in-out infinite;
  }
</style>
