---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// 获取所有关系
const relationships = await getCollection('relationships');
---

<BaseLayout title="关系图谱 | Kind-Black-Cat">
  <section class="max-w-7xl mx-auto px-6 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4"> 关系图谱</h1>
      <p class="text-xl text-[var(--color-muted)]">
        可视化关系网络，追踪情感走势
      </p>
    </div>

    {relationships.length === 0 ? (
      <div class="text-center py-20 editorial-card">
        <p class="text-[var(--color-muted)] text-lg">
          暂无关系数据。请在 <code class="bg-[var(--color-card)] px-2 py-1 rounded">src/content/relationships/</code> 目录下添加关系文件。
        </p>
      </div>
    ) : (
      <>
        <!-- 关系卡片网格 -->
        <div class="grid md:grid-cols-2 gap-6 mb-12">
          {relationships.map((rel) => (
            <div class="editorial-card">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-xl font-bold">{rel.data.name}</h3>
                <span class={`
                  px-3 py-1 rounded-full text-sm font-medium
                  ${rel.data.stockStatus.trend === 'up' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' : ''}
                  ${rel.data.stockStatus.trend === 'down' ? 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400' : ''}
                  ${rel.data.stockStatus.trend === 'stable' ? 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-400' : ''}
                `}>
                  {rel.data.stockStatus.trend === 'up' && '📈 上涨'}
                  {rel.data.stockStatus.trend === 'down' && '📉 下跌'}
                  {rel.data.stockStatus.trend === 'stable' && '➡️ 持平'}
                </span>
              </div>
              
              <div class="grid grid-cols-2 gap-4 text-sm mb-4">
                <div>
                  <span class="text-[var(--color-muted)]">关系类型:</span>
                  <span class="ml-2 font-medium">
                    {rel.data.type === 'romantic' && '恋人'}
                    {rel.data.type === 'rivals' && '宿敌'}
                    {rel.data.type === 'frenemies' && '亦敌亦友'}
                    {rel.data.type === 'siblings' && '手足'}
                    {rel.data.type === 'mentor' && '师徒'}
                    {rel.data.type === 'complicated' && '复杂'}
                  </span>
                </div>
                <div>
                  <span class="text-[var(--color-muted)]">关系性质:</span>
                  <span class={`ml-2 font-medium
                    ${rel.data.nature === 'pure' ? 'text-pink-500' : ''}
                    ${rel.data.nature === 'twisted' ? 'text-purple-500' : ''}
                    ${rel.data.nature === 'utilize' ? 'text-amber-500' : ''}
                    ${rel.data.nature === 'mutual' ? 'text-green-500' : ''}
                  `}>
                    {rel.data.nature === 'pure' && '纯爱'}
                    {rel.data.nature === 'twisted' && '扭曲'}
                    {rel.data.nature === 'utilize' && '利用'}
                    {rel.data.nature === 'mutual' && '相互'}
                  </span>
                </div>
              </div>
              
              <div class="flex gap-4 text-sm">
                <div class="flex-1 p-3 rounded-lg bg-pink-50 dark:bg-pink-900/20">
                  <div class="text-pink-600 dark:text-pink-400 font-medium">甜蜜指数</div>
                  <div class="text-2xl font-bold">{rel.data.vibeScore}</div>
                </div>
                <div class="flex-1 p-3 rounded-lg bg-purple-50 dark:bg-purple-900/20">
                  <div class="text-purple-600 dark:text-purple-400 font-medium">虐心指数</div>
                  <div class="text-2xl font-bold">{rel.data.angstScore}</div>
                </div>
                <div class="flex-1 p-3 rounded-lg bg-indigo-50 dark:bg-indigo-900/20">
                  <div class="text-indigo-600 dark:text-indigo-400 font-medium">当前股价</div>
                  <div class="text-2xl font-bold">{rel.data.stockStatus.current}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </>
    )}
  </section>
</BaseLayout>
